# URL do projeto Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Chave publishable do Supabase — segura para o browser, RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Chave da API da Anthropic (Claude) — server-side only, nunca expor ao browser
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Chave service_role do Supabase (Dashboard > Project Settings > API) — bypassa RLS,
# usada só pelo webhook do WhatsApp (não há sessão de usuário nesse contexto).
# Server-side only, NUNCA em NEXT_PUBLIC_*, nunca exposta ao browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Token que você mesmo define ao configurar o webhook no painel da Meta —
# usado para validar a chamada de verificação (GET) do webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN
# App Secret do app da Meta (Meta for Developers > seu app > Configurações básicas) —
# usado para validar a assinatura HMAC de cada mensagem recebida (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET
# Token de acesso da Cloud API (Meta for Developers > WhatsApp > API Setup) —
# usado para enviar mensagens via Graph API. Use o token permanente de Usuário do Sistema.
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN

# --- Embedded Signup (Tech Provider) ---
# App ID do app da Meta (Configurações do app > Básico) — NÃO é segredo, usado no SDK do
# Facebook no navegador para abrir o cadastro incorporado.
NEXT_PUBLIC_WHATSAPP_APP_ID=YOUR_META_APP_ID
# Config ID da configuração de login "Cadastro incorporado" (Login do Facebook para Empresas
# > Configurações) — NÃO é segredo, vai no FB.login({ config_id }).
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=YOUR_EMBEDDED_SIGNUP_CONFIG_ID
# PIN de 6 dígitos usado ao registrar o número do cliente na Cloud API (opcional — se
# vazio, pula o registro, que normalmente já é feito dentro do próprio cadastro).
WHATSAPP_REG_PIN=
# Observação: a troca do code por token no servidor reutiliza o WHATSAPP_APP_SECRET acima.

# Chave de API do Asaas (asaas.com > Configurações > Integrações > API) — use a chave de
# sandbox em dev. Server-side only, usada pra criar clientes/assinaturas/cobranças Pix.
ASAAS_API_KEY=YOUR_ASAAS_API_KEY
# URL base da API do Asaas — sandbox em dev, produção quando for pra valer.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que você mesmo define ao cadastrar o webhook no painel do Asaas — comparado com o
# header "asaas-access-token" de cada notificação recebida.
ASAAS_WEBHOOK_TOKEN=YOUR_ASAAS_WEBHOOK_TOKEN

# Chave da API do Resend (resend.com > API Keys) — e-mails transacionais (aviso de
# conversa transferida, etc). Sem a chave, os envios são apenas logados no console.
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Remetente dos e-mails — precisa de domínio verificado no Resend em produção.
# Em teste, "onboarding@resend.dev" funciona sem verificar domínio.
EMAIL_FROM=Agente de IA <onboarding@resend.dev>

# URL pública do app — usada nos links dos e-mails (ex.: https://seuapp.com.br)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo do header Authorization das rotas de cron (Vercel Cron). Gere um valor aleatório.
CRON_SECRET=YOUR_CRON_SECRET

# Connection string do Postgres do Supabase (Dashboard > Connect > Session pooler) —
# usada SÓ pelos testes de integração, que impersonam um usuário com
# `SET LOCAL ROLE authenticated` para conferir a RLS. Tudo roda dentro de
# BEGIN … ROLLBACK. Sem ela, o teste de RLS se marca como pulado.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

# Fila entre o webhook e o motor de IA (item A4). Lista de ids de organização
# separados por vírgula: nessas orgs o webhook grava a mensagem, responde 200 na
# hora e a resposta é gerada depois. Vazia ou ausente = DESLIGADA para todos, que
# é o comportamento antigo (a IA responde dentro do request da Meta). `*` liga
# para todas.
WEBHOOK_FILA_ORGS=

# --- API de parceiro (operação 5 do contrato do Wappia Vendas) ---
# Token que o sistema do cliente manda em Authorization: Bearer <token> ao
# avisar o desfecho de um orçamento (POST /api/v1/orcamentos/resultado).
# Gere um valor aleatório e combine com o desenvolvedor do cliente.
ORCAMENTOS_API_TOKEN=YOUR_ORCAMENTOS_API_TOKEN
# Organização dona dos eventos recebidos. Enquanto existe um cliente só, a
# credencial não é por organização — isso vira tabela de integrações no bloco C.
ORCAMENTOS_ORG_ID=YOUR_ORGANIZATION_UUID

# --- Transcrição de áudio (Whisper) ---
# Chave do fornecedor da transcrição. Vazia = transcrição desligada: o áudio do
# cliente fica marcado como "não foi possível ouvir" e a IA pede para escrever.
TRANSCRICAO_API_KEY=YOUR_TRANSCRICAO_API_KEY
# Fornecedor: groq (padrão) ou openai. Os dois usam o mesmo formato de API.
TRANSCRICAO_PROVEDOR=groq
# Opcional. Padrão: whisper-large-v3 na Groq, whisper-1 na OpenAI. Na OpenAI o recomendado é gpt-transcribe.
TRANSCRICAO_MODELO=
# Opcional, só para gpt-transcribe: palavras que ele deve reconhecer, separadas por vírgula (ex.: Jundiaí, Juniaí, vergalhão).
TRANSCRICAO_PALAVRAS=

# --- Pipeline de identificação de produto ---
# v1 (padrão) = motor atual. v2 = a IA só etiqueta e o código decide
# (src/lib/v2), só no roteiro de vendas. Qualquer valor diferente de "v2" é v1.
PIPELINE_VERSION=v1
# v2: depois da lista confirmada, a v1 segue para preço e orçamento (ligado). Vazio = para na lista
V2_ORCAMENTO=
# v2: a IA vê a lista e devolve as mudanças nela (tirar, trocar, quantidade, medida), conferidas pelo código (ligado). Vazio = frases fixas no código
V2_OPERACOES=
